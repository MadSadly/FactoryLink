# Gemini API Key (임베딩·자연어 처리·견적/계약 생성)
GEMINI_API_KEY=your-gemini-api-key
# 선택: 텍스트 모델
# GEMINI_TEXT_MODEL=gemini-2.0-flash
# 선택: 임베딩 모델
# GEMINI_EMBEDDING_MODEL=text-embedding-004

# MySQL/MariaDB (온톨로지·추천·견적/계약 INSERT)
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=factory_link

# PDF 저장 디렉터리 (선택, 미설정 시 시스템 TEMP 하위 factorylink_pdfs)
# PDF_OUTPUT_DIR=

# --- 레거시 예시 (미사용 시 무시) ---
# OPENAI_API_KEY=
