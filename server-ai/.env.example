# Google AI Studio / Gemini API (임베딩 유사도 + 계약서 생성 모두 동일 키)
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# 선택: Google Cloud 콘솔 등에서 쓰는 이름이 GOOGLE_API_KEY 인 경우 (둘 중 하나만 있으면 됨)
# GOOGLE_API_KEY=

# 선택: 텍스트 생성 모델 (기본 gemini-2.0-flash). 계정에서 허용된 모델명으로 변경 가능.
# GEMINI_TEXT_MODEL=gemini-2.0-flash
