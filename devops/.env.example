# ── Database ──────────────────────────────────────────
DB_ROOT_PASSWORD=change_me_root
DB_USER=factorylink
DB_PASS=change_me_pass
DB_NAME=factory_link
DB_HOST=localhost
DB_PORT=3306

# ── Spring Boot ───────────────────────────────────────
JWT_SECRET=change_me_jwt_secret_minimum_32_characters_long
JWT_EXPIRATION_MS=86400000

# ── AI Server ─────────────────────────────────────────
# Required for server-ai container startup (use a placeholder if you skip OpenAI calls)
OPENAI_API_KEY=sk-proj-replace_me

# ── Client (Docker build args / local client/.env) ───
VITE_KAKAO_MAP_KEY=
VITE_API_BASE_URL=http://localhost:8080/api
VITE_SOCKET_URL=http://localhost:3001
