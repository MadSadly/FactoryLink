# 개인 로컬/단일 서버용 예시 (이 파일을 복사해서 .env 로 저장하세요)
# 복사: devops 폴더에서 .env.example -> .env
#
# Docker Compose 실행 예:
#   docker compose --env-file devops/.env -f devops/docker-compose.yml up --build

# --- MariaDB ---
MYSQL_ROOT_PASSWORD=root
MARIADB_DATABASE=factory_link

# --- Spring Boot (데이터소스) ---
SPRING_DATASOURCE_URL=jdbc:mariadb://mariadb:3306/factory_link
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root

# --- AI (OpenAI, 없으면 템플릿 응답만 사용) ---
OPENAI_API_KEY=
