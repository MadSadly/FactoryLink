# ── Database ──────────────────────────────────────────
DB_ROOT_PASSWORD=change_me_root
DB_USER=factorylink
DB_PASS=change_me_pass
DB_NAME=factory_link
DB_HOST=localhost
DB_PORT=3306
# 선택: mysql.exe 가 PATH 에 없을 때 전체 경로 (db/scripts/load-schema-and-seed.bat)
# MYSQL_CMD=C:\Program Files\MariaDB 10.11\bin\mysql.exe
# 선택: CSV 임포트 시 인코딩 (db/scripts/import-csv-generic.bat). UTF-8 저장 파일이면 utf-8-sig
# CSV_ENCODING=utf-8-sig

# ── Spring Boot ───────────────────────────────────────
JWT_SECRET=change_me_jwt_secret_minimum_32_characters_long
JWT_EXPIRATION_MS=86400000

# ── AI Server ─────────────────────────────────────────
# 필수: Google AI Studio / Gemini API (임베딩·계약서 생성 동일 키)
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
# 선택: 텍스트 생성 모델 (기본 gemini-2.0-flash)
# GEMINI_TEXT_MODEL=gemini-2.0-flash
# Spring 추천 정렬 시 임베딩 유사도 사용 (기본 true). false면 규칙 점수만
# AI_EMBEDDING_ENABLED=true

# ── Gyeonggi OPEN API (Spring 동기화 또는 tools/fetch-gg-factryregist.mjs) ──
# https://openapi.gg.go.kr/FACTRYREGISTTM — Git에 커밋하지 말 것
GYEONGGI_OPENAPI_KEY=
# 서버 스케줄 동기화 사용 시 true (기본 false). EC2에서는 TZ=Asia/Seoul 권장.
GYEONGGI_SYNC_ENABLED=false
# 선택: GYEONGGI_SYNC_CRON=0 0 3 * * *
# 선택: GYEONGGI_SYNC_MAX_ROWS=3000

# ── Client (Docker build args / local client/.env) ───
VITE_KAKAO_MAP_KEY=
VITE_API_BASE_URL=http://localhost:8080/api
VITE_SOCKET_URL=http://localhost:3001
