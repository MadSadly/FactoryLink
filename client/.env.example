# Kakao Developers > 플랫폼 키 > JavaScript 키 (REST 키 아님)
# 웹 도메인: 브라우저 주소와 문자 하나까지 같아야 함. localhost 와 127.0.0.1 은 서로 다름.
VITE_KAKAO_MAP_KEY=

# API base (include /api). Dev with Vite proxy: leave unset to use "/api"
VITE_API_BASE_URL=http://localhost:8080/api

# 채팅 REST는 server-node(3001). 비우면 개발 시 Vite가 /api/chat 을 Node로 넘김.
# VITE_CHAT_API_BASE_URL=http://localhost:3001/api

# Socket.io server (chat)
VITE_SOCKET_URL=http://localhost:3001

# Python AI server (default 8000; match dev-start AI_PORT / Spring AI_SERVER_URL)
# VITE_AI_BASE_URL=http://localhost:8000
